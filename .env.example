# Aegis-Sync Environment Variables Configuration
# Copy this file to .env and replace the values with your own secure secrets.

# ==========================================
# Security & Authentication
# ==========================================
# This token is used to authenticate requests to the control plane (/chaos/* and /metrics/stream endpoints).
# WARNING: The default value in the codebase ("super-secret-admin") is for local demo purposes ONLY.
# In a production or publicly accessible environment, you MUST generate and set a strong, unique token.
ADMIN_SECRET_TOKEN=your-secure-token-here

# ==========================================
# Application Configuration (Optional)
# ==========================================
# REDIS_HOST=redis
# REDIS_PORT=6379
