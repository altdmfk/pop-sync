# PoP-Sync Environment Variables Configuration
# Copy this file to .env and replace the values with your own secure secrets.

# Security & Authentication
# Used to authenticate administrative requests to control plane (/chaos/*) and metrics.
ADMIN_SECRET_TOKEN=your-secure-token-here

# Application Configuration (Optional)
# REDIS_URL=redis://redis:6379
# DB_URL=http://policy_db:8000
# RL_ALGORITHM=sliding
# SINGLEFLIGHT_ENABLED=true
# CLUSTER_SINGLEFLIGHT_ENABLED=true
# POP_VERIFY_ENABLED=false

# Reverse Proxy (PEP) Mode
# UPSTREAM_URL=http://upstream-service:8080
# UPSTREAM_TIMEOUT_SEC=3.0

# Deep Healthcheck
# HEALTHCHECK_PING_TIMEOUT_SEC=0.2

# Redis Sentinel (HA) Configuration
# USE_REDIS_SENTINEL=false
# REDIS_SENTINEL_HOSTS=localhost:26379,localhost:26380
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_SOCKET_TIMEOUT=0.5

